# =========================
# GMAO local environment example
# Copy to .env for local usage and replace CHANGE_ME values.
# Never commit real secrets.
# =========================

# =========================
# Frontend
# =========================
VITE_API_BASE_URL=http://localhost:8080

# =========================
# Backend Spring Boot
# =========================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/gmao?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=gmao_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_JWT_EXPIRATION_MS=86400000

APP_AI_SERVICE_BASE_URL=http://ai-service:8000
APP_AI_SERVICE_CONNECT_TIMEOUT_MS=3000
APP_AI_SERVICE_READ_TIMEOUT_MS=120000

APP_DOCUMENTS_STORAGE_DIR=/app/uploads/equipment-documents
APP_DOCUMENTS_MAX_FILE_SIZE_BYTES=10485760

# Demo seed values. Keep enabled only for local/demo environments.
APP_SEED_ADMIN_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@gmao.com
APP_SEED_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN_PASSWORD
APP_SEED_DEMO_ENABLED=true

# =========================
# AI Service FastAPI
# =========================
SERVICE_NAME=gmao-ai-service
AI_PROVIDER=ollama

# If Ollama runs directly on Windows host, keep host.docker.internal.
# If Ollama runs as a Docker/Kubernetes service, use http://ollama:11434.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_COLLECTION=gmao_documents
DOCUMENTS_DIR=/app/documents
SOURCE_DOCUMENTS_DIR=/app/documents
CHROMA_DIR=/app/chroma_db
AUTO_SYNC_DOCUMENTS=true
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
MAX_DISTANCE=1.20

# =========================
# MySQL
# =========================
MYSQL_DATABASE=gmao
MYSQL_USER=gmao_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# =========================
# Monitoring
# =========================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
