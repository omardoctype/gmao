# =========================
# FRONTEND
# =========================
VITE_API_BASE_URL=https://api.gmao.example.com

# =========================
# BACKEND (SPRING BOOT)
# =========================
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://mysql.internal:3306/gmao?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=gmao_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

APP_CORS_ALLOWED_ORIGINS=https://gmao.example.com
APP_JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
APP_JWT_EXPIRATION_MS=86400000

APP_AI_SERVICE_BASE_URL=http://ai-service.internal:8000
APP_AI_SERVICE_CONNECT_TIMEOUT_MS=3000
APP_AI_SERVICE_READ_TIMEOUT_MS=120000

APP_DOCUMENTS_STORAGE_DIR=/data/uploads/equipment-documents
APP_DOCUMENTS_MAX_FILE_SIZE_BYTES=10485760

# Disable demo/admin auto seed in production
APP_SEED_ADMIN_ENABLED=false
APP_SEED_DEMO_ENABLED=false

# =========================
# AI SERVICE (FASTAPI)
# =========================
SERVICE_NAME=gmao-ai-service
OLLAMA_URL=http://ollama.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_COLLECTION=gmao_documents

DOCUMENTS_DIR=/data/documents
CHROMA_DIR=/data/chroma_db
SOURCE_DOCUMENTS_DIR=/data/documents
AUTO_SYNC_DOCUMENTS=false

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
MAX_DISTANCE=1.20

# =========================
# MYSQL (MANAGED)
# =========================
MYSQL_DATABASE=gmao
MYSQL_USER=gmao_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_IF_REQUIRED

